{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "gui",
        "model": {
          "type": "minecraft:model",
          "model": "epicfight:item/diamond_spear_gui"
        }
      },
      {
        "when": "fixed",
        "model": {
          "type": "minecraft:model",
          "model": "epicfight:item/diamond_spear_fixed"
        }
      },
      {
        "when": "ground",
        "model": {
          "type": "minecraft:model",
          "model": "epicfight:item/diamond_spear_ground"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "epicfight:item/diamond_spear"
    }
  }
}
